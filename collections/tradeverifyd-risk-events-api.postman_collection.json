                  "disabled": false,
                  "key": "event_types",
                  "value": "<string>",
                  "description": "If set, only Risk Events of the provided types will be included in the result set. If 'null', all types will be included in the result set."
                },
                {
                  "disabled": false,
                  "key": "event_types",
                  "value": "<string>",
                  "description": "If set, only Risk Events of the provided types will be included in the result set. If 'null', all types will be included in the result set."
