      "name": "Risk Events",
      "description": {
        "content": "Manage and retrieve events related to entities. This includes real-time updates on critical incidents like supply chain disruptions, compliance issues, or significant changes affecting entities. Stay informed about vital events that could impact your business operations and decision-making processes.",
        "type": "text/plain"
      },
