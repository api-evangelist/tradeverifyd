      "item": [
        {
          "id": "d26be021-2bb9-48c5-b8e0-f7ff60ba1b11",
          "name": "Get Relationship Types Detailed",
          "request": {
            "name": "Get Relationship Types Detailed",
            "description": {
              "content": "Get all available relationship types with enhanced metadata.\n\nThis endpoint provides a comprehensive list of all relationship types used in the system\nwith additional metadata including category, display name, and bidirectional flag.\n\n**Categories:**\nRelationship types are organized into two categories:\n- `affiliate`: Affiliate connections including ownership, control, and partnership relationships\n- `trade`: Trade relationships including supply chain, financial, corporate, and other business connections\n\nUse this endpoint to understand the meaning and categorization of relationship types\nthat appear in other API responses such as entity graphs and relationship queries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "relationship-types"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "b04bcc0a-5791-4115-ad5a-0e1aeb168a03",
              "name": "List of all available relationship types with enhanced metadata",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "relationship-types"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "ocp-apim-subscription-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"type\": \"IS_SUPPLIER_OF\",\n    \"display_name\": \"Is Supplier Of\",\n    \"category\": \"trade\",\n    \"description\": \"An entity provides goods or services to another entity, usually in a commercial context.\",\n    \"bidirectional\": false\n  },\n  {\n    \"type\": \"IS_AFFILIATE_OF\",\n    \"display_name\": \"Is Affiliate Of\",\n    \"category\": \"affiliate\",\n    \"description\": \"An entity is associated with another, usually through ownership or control.\",\n    \"bidirectional\": false\n  }\n]",
              "cookie": [],
