        {
          "id": "45d817f3-e1ac-463d-bf41-59ae26e821c3",
          "name": "Get Relationship Types",
          "request": {
            "name": "Get Relationship Types",
            "description": {
              "content": "Get all available relationship types with their descriptions.\n\nThis endpoint provides a comprehensive list of all relationship types used in the system\n(e.g., \"IS_SUPPLIER_OF\", \"IS_OTHERWISE_LINKED_TO\", \"DIRECTLY_CONSOLIDATES\") along with\ndetailed descriptions of what each type means.\n\nUse this endpoint to understand the meaning of relationship types that appear in other\nAPI responses such as entity graphs and relationship queries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "relationships",
                "types"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "0d9046e0-b92b-4687-9184-df4f12c6f8d1",
              "name": "List of all available relationship types with their descriptions",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "relationships",
                    "types"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "ocp-apim-subscription-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"relationship_type\": \"IS_SUPPLIER_OF\",\n    \"description\": \"An entity provides goods or services to another entity, usually in a commercial context.\"\n  },\n  {\n    \"relationship_type\": \"IS_OTHERWISE_LINKED_TO\",\n    \"description\": \"One entity has been manually identified as relating to another, or there is a business reason to display two entities as connected when they otherwise would not be. Relations of this type must have a batch ID so they can easily be removed. The meaning of this relationship is poorly-defined and should be used sparingly as a last resort.\"\n  },\n  {\n    \"relationship_type\": \"DIRECTLY_CONSOLIDATES\",\n    \"description\": \"The parent entity fully consolidates the accounts of the child entity, as per the accounting standard(s) specified; the child entity is the closest entity being fully consolidated by the parent in any applicable hierarchical ownership structure.\"\n  }\n]",
              "cookie": [],
              "_postman_previewlanguage": "json"
