          "name": "Register Statement",
          "request": {
            "name": "Register Statement",
            "description": {
              "content": "Register a new COSE Sign1 statement in the transparency log.\nThe statement will be assigned an entry ID and included in the Merkle tree.\n\nSupports both application/cose and application/scitt-statement+cose content types.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "entries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
